# Self-hosted fx0 (docker compose). Copy to .env next to docker-compose.yml and fill in SESSION_SECRET.

# Required: at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# The address you open fx0 at. It must match exactly, or requests are refused
# as cross-origin. To reach it from other machines, set FX0_BIND=0.0.0.0 and
# APP_URL=http://<this-host>:3000. Anyone who can reach it signs in as the local
# user, so keep it on a trusted network or behind an authenticating proxy.
APP_URL=http://localhost:3000
# FX0_BIND=127.0.0.1
# FX0_PORT=3000

# The Ollama model new chats start on, and any others to offer in the picker
# (comma separated). The model needs good tool calling: qwen3:14b, qwen3:32b,
# qwen3-coder:30b, gpt-oss:20b and llama3.3:70b are reasonable choices.
FX0_MODEL=qwen3:14b
# FX0_LOCAL_MODELS=qwen3-coder:30b,gpt-oss:20b

# The context window Ollama runs with, and that fx0 compacts against.
# Larger needs more memory; designs are long, so 32k is a practical minimum.
# FX0_CONTEXT_WINDOW=32768
# FX0_LOCAL_MAX_OUTPUT_TOKENS=16384
# Set to 1 for a vision model, so pasted images reach it.
# FX0_LOCAL_VISION=0

# Use another OpenAI-compatible server instead of the bundled Ollama
# (vLLM, llama.cpp server, LM Studio...). The URL ends at /v1.
# FX0_LOCAL_MODEL_URL=http://host.docker.internal:8000/v1
# FX0_LOCAL_MODEL_KEY=

# FX0_LOCAL_USER_EMAIL=local@localhost
# FX0_LOCAL_USER_NAME=Local user
# POSTGRES_PASSWORD=fx0
# REDIS_HTTP_TOKEN=fx0-local-redis
